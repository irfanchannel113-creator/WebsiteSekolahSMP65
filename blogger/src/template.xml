          <b:widget-setting name='text-6'>Alamat dan Kontak</b:widget-setting>
          <b:widget-setting name='link-6'>/p/alamat-dan-kontak.html</b:widget-setting>
        </b:widget-settings>
        <b:includable id='main'>
          <h3><data:title/></h3>
          <ul class='footer-list footer-links'>
            <b:loop values='data:links' var='link'>
              <li><svg aria-hidden='true' class='ic' fill='none' stroke='currentColor' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.8' viewBox='0 0 24 24'><path d='M5 12h14M13 6l6 6-6 6'/></svg><a expr:href='data:link.target'><data:link.name/></a></li>
