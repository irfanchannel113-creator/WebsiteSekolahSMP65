                <svg aria-hidden='true' class='ic' fill='none' stroke='currentColor' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.8' viewBox='0 0 24 24'><rect height='7' rx='1.5' width='7' x='4' y='4'/><rect height='7' rx='1.5' width='7' x='13' y='4'/><rect height='7' rx='1.5' width='7' x='4' y='13'/><rect height='7' rx='1.5' width='7' x='13' y='13'/></svg>
